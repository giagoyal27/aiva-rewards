# ============================================================
# AIVA Rewards — Environment Configuration
# Copy this file to ".env" and fill in real values before running.
# NEVER commit your real .env file.
# ============================================================

# --- Database ---------------------------------------------------
# Default: local SQLite file, zero setup, perfect for dev/small deployments.
DATABASE_URL="file:./dev.db"
# For Postgres in production, use something like:
# DATABASE_URL="postgresql://user:password@host:5432/aiva?schema=public"

# --- Auth / Sessions ---------------------------------------------
# Random long secret used to sign customer + admin session JWTs.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"
#
# Customer authentication uses Name + Mobile Number + Card Number only
# (registration), and Mobile Number + Card Number (login) — there is no
# OTP or password step for customers. See src/app/api/auth/register and
# src/app/api/auth/login for the exact logic.

# --- Seed / Admin bootstrap ----------------------------------------
# Used only by `npm run db:seed`. Change before seeding a real environment.
SEED_ADMIN_EMAIL="admin@aiva.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- App -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AIVA"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
